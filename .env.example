# ======================================================
# piWebUI 环境配置文件
# ======================================================

# 访问密码配置（自定义你的专属密码）：
# 若留空，则不开启密码验证（免密运行）；
# 若填写（例如：PI_AUTH_TOKEN=mypassword123），则任何设备访问均需输入该密码解锁。
PI_AUTH_TOKEN=

# 客户端密码记住/缓存策略（仅在设置了 PI_AUTH_TOKEN 时生效）：
# - 'true' (默认): 缓存在浏览器的 localStorage 中，长期免密（同一设备只需输入一次）；
# - 'session': 仅在当前会话保持登录（保存在 sessionStorage，关闭浏览器或标签页后失效需重新输入）；
# - 'false': 完全不缓存密码到浏览器存储，每次刷新页面或重新打开网页均需重新输入密码。
PI_AUTH_REMEMBER=true

# 客户端空闲自动回收时间（秒，默认 1800 秒即 30 分钟）
# 当某个网页端闲置达到此时长，后端将自动回收底层的 Node.js 进程释放内存。
PI_CLIENT_IDLE_TIMEOUT=1800.0

# 工具执行安全确认策略（Human-in-the-loop 人类在环审核）：
# - 'manual': 手动确认模式。无论是否为高危命令，每次 Agent 申请在宿主机执行终端命令或调用工具时，
#             均会在网页端聊天流中弹出确认卡片，展示具体命令内容，必须用户手动点击【允许执行】才会运行。
# - 'safe' (默认推荐): 智能安全模式。对只读或安全命令自动放行；仅拦截识别为高危破坏性指令（如 rm -rf, del /s, drop table, 格式化等）并在网页端提示手动审核。
# - 'allow_all': 全自动放行模式。所有工具与命令直接自动执行，不拦截确认。
# - 'deny': 全拦截模式。自动拒绝所有工具确认请求。
PI_AUTO_APPROVE_POLICY=safe

# 跨域安全白名单（可选）：
# 默认已通过正则自动放行 localhost 以及所有私有局域网 IP（192.168.x.x / 10.x.x.x / 172.16-31.x.x / 100.x.x.x Tailscale）。
# 如果部署了公网域名（如 https://chat.example.com），在此填写逗号隔开的完整域名：
# CORS_ALLOWED_ORIGINS=https://chat.example.com
